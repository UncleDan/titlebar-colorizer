{
  "manifest_version": 3,
  "name": "Titlebar Colorizer Multi",
  "version": "2.0.3",
  "version_name": "2.0.3",
  "author": "Daniele Lolli (UncleDan)",
  "description": "Customize the titlebar color with automatic contrast calculation for Firefox, LibreWolf and Thunderbird.",
  "developer": {
    "name": "Daniele Lolli (UncleDan)",
    "url": "https://danielelolli.it"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "titlebar-colorizer-multi@uncledan.it",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "permissions": [
    "theme",
    "storage"
  ],
  "background": {
    "scripts": [
      "theme-core.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Configure Titlebar"
  }
}