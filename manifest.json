{
  "manifest_version": 3,
  "name": "Titlebar Colorizer Multi",
  "version": "1.99.3",
  "version_name": "2.0b3",
  "author": "Daniele Lolli (UncleDan)",
  "description": "Customize the titlebar color with automatic contrast calculation for Firefox, LibreWolf and Thunderbird.",
  "developer": {
    "name": "Daniele Lolli (UncleDan)",
    "url": "https://danielelolli.it"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "titlebar-colorizer-multi@uncledan.it",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "theme",
    "storage"
  ],
  "background": {
    "scripts": [
      "theme-core.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Configure Titlebar"
  }
}